        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Jogo deve retornar 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Deve possuir cabeçalho Location\", function () {\r\n    pm.expect(pm.response.headers.has(\"Location\")).to.be.true;\r\n});\r\n\r\nconst body = pm.response.json();\r\n\r\npm.test(\"Jogo deve referenciar o gênero criado\", function () {\r\n    pm.expect(body.generoId).to.eql(\r\n        Number(pm.collectionVariables.get(\"generoId\"))\r\n    );\r\n});\r\n\r\npm.test(\"Jogo deve referenciar a desenvolvedora criada\", function () {\r\n    pm.expect(body.desenvolvedoraId).to.eql(\r\n        Number(pm.collectionVariables.get(\"desenvolvedoraId\"))\r\n    );\r\n});\r\n\r\npm.collectionVariables.set(\"jogoId\", body.id);"
            ]
          }
        }
