{
  "info": {
    "_postman_id": "2f5b5bb4-58dc-45ce-b79f-aula12jogos2026",
    "name": "Jogos 2026 - Aula 12",
    "description": "Bootstrap didático, HTTP Basic, alteração de senha e respostas 401. Contém somente credenciais fictícias.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{authLogin}}", "type": "string" },
      { "key": "password", "value": "{{authPassword}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "pessoaId", "value": "" },
    { "key": "authLogin", "value": "" },
    { "key": "authOldPassword", "value": "uma-frase-senha-2026" },
    { "key": "authNewPassword", "value": "outra-frase-senha-2026" },
    { "key": "authPassword", "value": "uma-frase-senha-2026" },
    { "key": "cpf", "value": "" },
    { "key": "email", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Health público",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Health público deve retornar 200', () => pm.response.to.have.status(200));"
        ] }
      }]
    },
    {
      "name": "02 - Criar pessoa para bootstrap",
      "event": [
        {
          "listen": "prerequest",
          "script": { "exec": [
            "const sufixo = Date.now().toString();",
            "let base = sufixo.slice(-9).padStart(9, '0');",
            "if (/^(.)\\1+$/.test(base)) base = '123456789';",
            "const digito = (valor, peso) => {",
            "  let soma = 0;",
            "  for (const caractere of valor) soma += Number(caractere) * peso--;",
            "  const resto = soma % 11;",
            "  return resto < 2 ? 0 : 11 - resto;",
            "};",
            "const primeiro = digito(base, 10);",
            "const cpf = base + primeiro + digito(base + primeiro, 11);",
            "pm.collectionVariables.set('cpf', cpf);",
            "pm.collectionVariables.set('email', `aula12.${sufixo}@example.com`);",
            "pm.collectionVariables.set('authLogin', `operador.${sufixo}`);",
            "pm.collectionVariables.set('authPassword', pm.collectionVariables.get('authOldPassword'));"
          ] }
        },
        {
          "listen": "test",
          "script": { "exec": [
            "pm.test('Pessoa deve ser criada', () => pm.response.to.have.status(201));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('pessoaId', json.id);"
          ] }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Operadora Aula 12\",\n  \"email\": \"{{email}}\",\n  \"cpf\": \"{{cpf}}\"\n}"
        },
        "url": "{{baseUrl}}/api/pessoas"
      }
    },
    {
      "name": "03 - Criar conta pública",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pessoaId\": {{pessoaId}},\n  \"login\": \"{{authLogin}}\",\n  \"senha\": \"{{authOldPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/contas-acesso"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Conta deve ser criada', () => pm.response.to.have.status(201));",
          "const json = pm.response.json();",
          "pm.test('Perfil inicial deve ser OPERADOR', () => pm.expect(json.perfis).to.include('OPERADOR'));",
          "pm.test('Resposta não deve expor senha ou hash', () => {",
          "  pm.expect(json).not.to.have.property('senha');",
          "  pm.expect(json).not.to.have.property('senhaHash');",
          "});"
        ] }
      }]
    },
    {
      "name": "04 - Negar rota protegida sem credencial",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/jogos"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Rota protegida deve retornar 401', () => pm.response.to.have.status(401));"
        ] }
      }]
    },
    {
      "name": "05 - Consultar própria conta",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/contas-acesso/me" },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Credencial correta deve retornar 200', () => pm.response.to.have.status(200));",
          "pm.test('Login autenticado deve ser devolvido', () => pm.expect(pm.response.json().login).to.eql(pm.collectionVariables.get('authLogin')));"
        ] }
      }]
    },
    {
      "name": "06 - Negar senha incorreta",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{authLogin}}", "type": "string" },
            { "key": "password", "value": "senha-incorreta-2026", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/contas-acesso/me"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Senha incorreta deve retornar 401', () => pm.response.to.have.status(401));"
        ] }
      }]
    },
    {
      "name": "07 - Alterar senha",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senhaAtual\": \"{{authOldPassword}}\",\n  \"novaSenha\": \"{{authNewPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/contas-acesso/me/senha"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Alteração deve retornar 204', () => pm.response.to.have.status(204));",
          "pm.collectionVariables.set('authPassword', pm.collectionVariables.get('authNewPassword'));"
        ] }
      }]
    },
    {
      "name": "08 - Negar senha anterior",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{authLogin}}", "type": "string" },
            { "key": "password", "value": "{{authOldPassword}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/contas-acesso/me"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Senha anterior deve retornar 401', () => pm.response.to.have.status(401));"
        ] }
      }]
    },
    {
      "name": "09 - Autenticar com nova senha",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/contas-acesso/me" },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Nova senha deve autenticar', () => pm.response.to.have.status(200));",
          "const json = pm.response.json();",
          "pm.test('Resposta continua sem credenciais', () => {",
          "  pm.expect(json).not.to.have.property('senha');",
          "  pm.expect(json).not.to.have.property('senhaHash');",
          "});"
        ] }
      }]
    }
  ]
}
