      "name": "05 - Pesquisar jogos com paginação",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Pesquisa deve retornar 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst body = pm.response.json();\r\n\r\npm.test(\"Resposta deve possuir conteúdo paginado\", function () {\r\n    pm.expect(body.conteudo).to.be.an(\"array\");\r\n    pm.expect(body.pagina).to.eql(0);\r\n    pm.expect(body.tamanho).to.eql(5);\r\n    pm.expect(body.totalElementos).to.be.a(\"number\");\r\n    pm.expect(body.totalPaginas).to.be.a(\"number\");\r\n    pm.expect(body.primeira).to.be.a(\"boolean\");\r\n    pm.expect(body.ultima).to.be.a(\"boolean\");\r\n});\r\n\r\npm.test(\"Página deve conter o jogo criado\", function () {\r\n    const jogoId = Number(\r\n        pm.collectionVariables.get(\"jogoId\")\r\n    );\r\n\r\n    const encontrado = body.conteudo.some(\r\n        jogo => jogo.id === jogoId\r\n    );\r\n\r\n    pm.expect(encontrado).to.be.true;\r\n});"
            ]
          }
        }
