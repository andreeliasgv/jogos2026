{
  "info": {
    "_postman_id": "a16f2026-0000-4000-8000-jogos2026",
    "name": "Jogos 2026 - Aula 16",
    "description": "Ciclo de access e refresh tokens. Preencha adminPassword apenas localmente antes de executar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminLogin", "value": "administrador" },
    { "key": "adminPassword", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "refreshTokenAnterior", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Health público",
      "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/health" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Health deve retornar 200', () => pm.response.to.have.status(200));"
      ] } }]
    },
    {
      "name": "02 - Login inicia uma família",
      "request": {
        "auth": { "type": "noauth" }, "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"login\": \"{{adminLogin}}\",\n  \"senha\": \"{{adminPassword}}\"\n}" },
        "url": "{{baseUrl}}/api/autenticacao/login"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Login deve retornar 200', () => pm.response.to.have.status(200));",
        "const json = pm.response.json();",
        "pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
        "pm.expect(json.refreshToken).to.be.a('string').and.not.empty;",
        "pm.collectionVariables.set('accessToken', json.accessToken);",
        "pm.collectionVariables.set('refreshToken', json.refreshToken);"
      ] } }]
    },
    {
      "name": "03 - Renovar e rotacionar",
      "request": {
        "auth": { "type": "noauth" }, "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
        "url": "{{baseUrl}}/api/autenticacao/refresh"
      },
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "pm.collectionVariables.set('refreshTokenAnterior', pm.collectionVariables.get('refreshToken'));"
        ] } },
        { "listen": "test", "script": { "exec": [
          "pm.test('Renovação deve retornar 200', () => pm.response.to.have.status(200));",
          "const json = pm.response.json();",
          "pm.test('Refresh token deve ser rotacionado', () => pm.expect(json.refreshToken).not.eql(pm.collectionVariables.get('refreshTokenAnterior')));",
          "pm.collectionVariables.set('accessToken', json.accessToken);",
          "pm.collectionVariables.set('refreshToken', json.refreshToken);"
        ] } }
      ]
    },
    {
      "name": "04 - Reutilizar token anterior revoga a família",
      "request": {
        "auth": { "type": "noauth" }, "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshTokenAnterior}}\"\n}" },
        "url": "{{baseUrl}}/api/autenticacao/refresh"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Reutilização deve retornar 401', () => pm.response.to.have.status(401));"
      ] } }]
    },
    {
      "name": "05 - Token atual também foi revogado",
      "request": {
        "auth": { "type": "noauth" }, "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
        "url": "{{baseUrl}}/api/autenticacao/refresh"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Família revogada deve retornar 401', () => pm.response.to.have.status(401));"
      ] } }]
    },
    {
      "name": "06 - Novo login para testar logout",
      "request": {
        "auth": { "type": "noauth" }, "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"login\": \"{{adminLogin}}\",\n  \"senha\": \"{{adminPassword}}\"\n}" },
        "url": "{{baseUrl}}/api/autenticacao/login"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Novo login deve retornar 200', () => pm.response.to.have.status(200));",
        "const json = pm.response.json();",
        "pm.collectionVariables.set('accessToken', json.accessToken);",
        "pm.collectionVariables.set('refreshToken', json.refreshToken);"
      ] } }]
    },
    {
      "name": "07 - Logout local",
      "request": {
        "auth": { "type": "noauth" }, "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
        "url": "{{baseUrl}}/api/autenticacao/logout"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Logout local deve retornar 204', () => pm.response.to.have.status(204));"
      ] } }]
    },
    {
      "name": "08 - Logout impede nova renovação",
      "request": {
        "auth": { "type": "noauth" }, "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
        "url": "{{baseUrl}}/api/autenticacao/refresh"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Refresh após logout deve retornar 401', () => pm.response.to.have.status(401));"
      ] } }]
    },
    {
      "name": "09 - Login para testar logout global",
      "request": {
        "auth": { "type": "noauth" }, "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"login\": \"{{adminLogin}}\",\n  \"senha\": \"{{adminPassword}}\"\n}" },
        "url": "{{baseUrl}}/api/autenticacao/login"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Login deve retornar 200', () => pm.response.to.have.status(200));",
        "const json = pm.response.json();",
        "pm.collectionVariables.set('accessToken', json.accessToken);",
        "pm.collectionVariables.set('refreshToken', json.refreshToken);"
      ] } }]
    },
    {
      "name": "10 - Logout global",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "method": "POST", "url": "{{baseUrl}}/api/autenticacao/logout-todos"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Logout global deve retornar 204', () => pm.response.to.have.status(204));"
      ] } }]
    },
    {
      "name": "11 - Logout global impede renovação",
      "request": {
        "auth": { "type": "noauth" }, "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
        "url": "{{baseUrl}}/api/autenticacao/refresh"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Refresh após logout global deve retornar 401', () => pm.response.to.have.status(401));"
      ] } }]
    },
    {
      "name": "12 - Access token permanece válido até expirar",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "method": "GET", "url": "{{baseUrl}}/api/contas-acesso/me"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Access token já emitido deve continuar válido', () => pm.response.to.have.status(200));"
      ] } }]
    }
  ]
}
