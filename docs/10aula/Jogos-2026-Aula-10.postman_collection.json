      "name": "01 - Iniciar cenário e verificar saúde",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const seed = Date.now().toString();",
              "function repetidos(valor) { return valor.split('').every(c => c === valor[0]); }",
              "function digitoCpf(base, peso) {",
              "  let soma = 0;",
              "  for (const c of base) soma += Number(c) * peso--;",
              "  const resto = soma % 11;",
              "  return resto < 2 ? 0 : 11 - resto;",
              "}",
              "function gerarCpf() {",
              "  let base = seed.slice(-9).padStart(9, '1');",
              "  if (repetidos(base)) base = '123456789';",
              "  const primeiro = digitoCpf(base, 10);",
              "  return base + primeiro + digitoCpf(base + primeiro, 11);",
              "}",
              "function digitoCnpj(base) {",
              "  let peso = base.length - 7;",
              "  let soma = 0;",
              "  for (const c of base) { soma += Number(c) * peso--; if (peso === 1) peso = 9; }",
              "  const resto = soma % 11;",
              "  return resto < 2 ? 0 : 11 - resto;",
              "}",
              "function gerarCnpj() {",
              "  let base = ('12' + seed.slice(-10)).slice(-12);",
              "  if (repetidos(base)) base = '123456780001';",
              "  const primeiro = digitoCnpj(base);",
              "  return base + primeiro + digitoCnpj(base + primeiro);",
              "}",
              "pm.collectionVariables.set('runId', seed);",
              "pm.collectionVariables.set('cpfCliente', gerarCpf());",
              "const outraBase = String(BigInt(seed) + 7919n).slice(-9).padStart(9, '2');",
              "const primeiro = digitoCpf(outraBase, 10);",
              "pm.collectionVariables.set('cpfVendedor', outraBase + primeiro + digitoCpf(outraBase + primeiro, 11));",
              "pm.collectionVariables.set('cnpjFornecedor', gerarCnpj());"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Health deve retornar 200', () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
