# Desenvolvimento
DB_DEV_URL=jdbc:postgresql://localhost:5432/jogos2026_dev
DB_DEV_USERNAME=jogos_app
DB_DEV_PASSWORD=senha_local

# Testes
DB_TEST_URL=jdbc:postgresql://localhost:5432/jogos2026_test
DB_TEST_USERNAME=jogos_app
DB_TEST_PASSWORD=senha_local

# Produção: valores fornecidos pela plataforma
DB_URL=jdbc:postgresql://servidor:5432/banco
DB_USERNAME=usuario_da_aplicacao
DB_PASSWORD=segredo_da_plataforma

# Bancos descartáveis da geração de migrations
DB_DIFF_URL=jdbc:postgresql://localhost:5432/jogos2026_diff
DB_DIFF_USERNAME=jogos_app
DB_DIFF_PASSWORD=senha_local

DB_REFERENCE_URL=jdbc:postgresql://localhost:5432/jogos2026_reference
DB_REFERENCE_USERNAME=jogos_app
DB_REFERENCE_PASSWORD=senha_local

# Gere uma chave Base64 aleatória de 256 bits para cada ambiente.
JWT_SECRET=substitua-por-uma-chave-base64-de-256-bits

# Provisionamento único do primeiro administrador. Desative após criar a conta.
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_NAME=Administrador Local
INITIAL_ADMIN_EMAIL=administrador@example.com
INITIAL_ADMIN_CPF=52998224725
INITIAL_ADMIN_LOGIN=administrador
INITIAL_ADMIN_PASSWORD=substitua-por-uma-senha-forte-e-local
